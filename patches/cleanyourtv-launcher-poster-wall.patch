+/**
+ * The poster flip wall: movie posters in a slightly tilted grid that flips between colour moods —
+ * the phone preview's engine (poster-wall/index.html) ported one-to-one. Data comes from
+ * {@code files/posterwall/manifest.json + posters/}, pushed with the theme; the board sits behind
+ * the launcher as the backdrop layer.
+ *
+ * A flip is the classic two-stage Android card flip (CSS has backface-visibility, Android does
+ * not): the card turns to edge-on at 90°, the face swaps, then it turns the rest of the way.
+ * Manifest parsing and bitmap decoding run on a background executor; flips and scheduling run on
+ * the main thread through a Handler whose pending callbacks are tracked, so {@link #setPaused(boolean)}
+ * freezes and restarts the choreography cleanly.
+ */
+public class PosterWallView extends FrameLayout {
+
+    private static final class Poster {
+        final String file;      // "posters/xxx.jpg", relative to the posterwall dir
+        final String title;
+        final int dom;          // dominant colour; placeholder tiles paint with it
+        final boolean ph;       // no image: draw a colour placeholder
+        Poster(String file, String title, int dom, boolean ph) {
+            this.file = file;
+            this.title = title;
+            this.dom = dom;
+            this.ph = ph;
+        }
+    }
+
+    private static final class Cell {
+        FrameLayout card;
+        ImageView front;
+        ImageView back;
+        int cur = -1;
+        boolean busy;
+        int c;
+        int r;
+    }
+
+    private static final class FlipEntry {
+        final int idx;
+        final long t;
+        final int dur;
+        FlipEntry(int idx, long t, int dur) {
+            this.idx = idx;
+            this.t = t;
+            this.dur = dur;
+        }
+    }
+
+    private static final class ManifestData {
+        final List<Poster> posters = new ArrayList<>();
+        final Map<String, List<Integer>> moods = new HashMap<>();
+
+        static ManifestData load(File file) {
+            if (!file.isFile()) return null;
+            try (FileInputStream in = new FileInputStream(file)) {
+                byte[] b = new byte[(int) file.length()];
+                int off = 0;
+                while (off < b.length) {
+                    int n = in.read(b, off, b.length - off);
+                    if (n < 0) break;
+                    off += n;
+                }
+                JSONObject json = new JSONObject(new String(b, 0, off, StandardCharsets.UTF_8));
+                ManifestData data = new ManifestData();
+                JSONArray ps = json.getJSONArray("posters");
+                for (int i = 0; i < ps.length(); i++) {
+                    JSONObject p = ps.getJSONObject(i);
+                    int dom;
+                    try {
+                        dom = Color.parseColor(p.optString("dom", "#333333"));
+                    } catch (IllegalArgumentException ignored) {
+                        dom = 0xFF333333;
+                    }
+                    data.posters.add(new Poster(p.optString("file", ""), p.optString("title", ""),
+                            dom, p.optBoolean("ph", false)));
+                }
+                JSONObject ms = json.getJSONObject("moods");
+                Iterator<String> it = ms.keys();
+                while (it.hasNext()) {
+                    String name = it.next();
+                    JSONArray arr = ms.getJSONArray(name);
+                    List<Integer> idx = new ArrayList<>();
+                    for (int i = 0; i < arr.length(); i++) idx.add(arr.getInt(i));
+                    data.moods.put(name, idx);
+                }
+                return data;
+            } catch (Exception e) {
+                return null;
+            }
+        }
+    }
+
+    private final float density;
+    private final Random rnd = new Random();
