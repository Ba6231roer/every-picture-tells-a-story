+    /** Grid sized to cover the screen even when the board is rotated by the tilt angle. */
+    private void buildGrid() {
+        int w = getWidth();
+        int h = getHeight();
+        if (w == 0 || h == 0) return;
+        double th = Math.toRadians(tilt);
+        int covW = (int) ((w * Math.cos(th) + h * Math.sin(th)) * 1.16);
+        int covH = (int) ((w * Math.sin(th) + h * Math.cos(th)) * 1.16);
+        int gap = Math.round(gapDp * density);
+        cellW = (covW - gap * (cols - 1)) / cols;
+        cellH = cellW * 3 / 2;
+        rows = Math.max(1, (int) Math.ceil((covH - gap) / (double) (cellH + gap)));
+        removeAllViews();
+        cells.clear();
+        FrameLayout boardWrap = new FrameLayout(getContext());
+        boardWrap.setClipChildren(false);
+        board = new FrameLayout(getContext());
+        board.setClipChildren(false);
+        board.setRotation(tilt);
+        LayoutParams blp = new LayoutParams(covW, covH);
+        blp.gravity = Gravity.CENTER;
+        boardWrap.addView(board, blp);
+        addView(boardWrap, new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT));
+        for (int r = 0; r < rows; r++) {
+            for (int c = 0; c < cols; c++) {
+                Cell cell = new Cell();
+                cell.c = c;
+                cell.r = r;
+                FrameLayout card = new FrameLayout(getContext());
+                card.setClipChildren(false);
+                card.setCameraDistance(density * 4800);
+                ImageView front = face();
+                ImageView back = face();
+                back.setRotationY(180f);
+                back.setVisibility(INVISIBLE);
+                card.addView(front, new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT));
+                card.addView(back, new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT));
+                cell.card = card;
+                cell.front = front;
+                cell.back = back;
+                FrameLayout cellView = new FrameLayout(getContext());
+                cellView.setClipChildren(false);
+                cellView.addView(card, new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT));
+                LayoutParams lp = new LayoutParams(cellW, cellH);
+                lp.leftMargin = c * (cellW + gap);
+                lp.topMargin = r * (cellH + gap);
+                board.addView(cellView, lp);
+                cells.add(cell);
+            }
+        }
+        ensureOverlays();
+    }
