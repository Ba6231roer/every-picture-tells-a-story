+    private final ExecutorService io = Executors.newSingleThreadExecutor();
+    private final LruCache<String, Bitmap> cache;
+    private final List<Cell> cells = new ArrayList<>();
+    private final Map<String, List<Integer>> moods = new HashMap<>();
+    private final List<Poster> posters = new ArrayList<>();
+
+    private int cols = 9;
+    private int tilt = 6;
+    private int gapDp = 10;
+    private String mode = "rippleRing";
+    private int dur = 650;
+    private int interval = 110;
+    private int hold = 9;
+    private boolean ambient = true;
+    private int ambientEvery = 8;
