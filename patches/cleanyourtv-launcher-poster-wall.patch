+        running = true;
+        File base = new File(dir, "posterwall");
+        io.execute(() -> {
+            ManifestData data = ManifestData.load(new File(base, "manifest.json"));
+            handler.post(() -> {
+                if (!running || data == null || data.posters.isEmpty()) return;
+                posters.clear();
+                posters.addAll(data.posters);
+                moods.clear();
+                moods.putAll(data.moods);
