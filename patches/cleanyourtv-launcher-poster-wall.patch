+        int sw = 480, sh = 270;
+        if (snapBmp == null) {
+            snapBmp = Bitmap.createBitmap(sw, sh, Bitmap.Config.ARGB_8888);
+            blurBmp = Bitmap.createBitmap(sw, sh, Bitmap.Config.ARGB_8888);
+            outBmp = Bitmap.createBitmap(sw, sh, Bitmap.Config.ARGB_8888);
+        }
+        if (rs == null) {
+            try {
+                rs = RenderScript.create(getContext());
+                rsIn = Allocation.createFromBitmap(rs, snapBmp);
+                rsOut = Allocation.createTyped(rs, rsIn.getType());
+                blurScript = ScriptIntrinsicBlur.create(rs, Element.U8_4(rs));
+                blurScript.setRadius(Math.max(2f, Math.min(25f, blur * 0.4f)));
+            } catch (Throwable t) {
+                rs = null;   // RS 不可用则模糊层退化为快照原样
+            }
+        }
+        blurView.setImageBitmap(outBmp);
+        refreshOverlays();
+    }
+
+    /* ---------------- 画面效果层（暗角 + 边缘模糊）---------------- */
+
+    /** 暗角/模糊两层盖在棋盘上、位于启动器 UI 之下；参数变化后重画贴图/蒙版。 */
+    private void refreshOverlays() {
+        if (vignetteView == null) return;
+        String vigKey2 = vig + "|" + fxRange;
+        if (vigBmp == null || !vigKey2.equals(vigKey)) {
+            vigKey = vigKey2;
+            vigBmp = makeRadialBitmap(vig / 100f * 0.85f, fxRange, false);
+            vignetteView.setImageBitmap(vigBmp);
+        }
+        vignetteView.setVisibility(vig > 0 ? VISIBLE : GONE);
+        blurView.setVisibility(blur > 0 ? VISIBLE : GONE);
+        if (maskBmp == null || maskRange != fxRange) {
+            maskRange = fxRange;
+            maskBmp = makeRadialBitmap(1f, fxRange, true);
+        }
+    }
+
+    /** 椭圆径向 alpha 贴图：depth=1 时纯蒙版（alpha 只随距离），否则 alpha = t*depth。 */
+    private Bitmap makeRadialBitmap(float depth, int range, boolean maskOnly) {
+        int w = 320, h = 180;
+        Bitmap bm = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+        int[] px = new int[w * h];
+        float cx = w * 0.5f, cy = h * 0.46f, rx = w * 1.2f, ry = h * 0.9f;
+        float d0 = range / 100f - 0.16f, d1 = range / 100f + 0.16f;
+        for (int y = 0; y < h; y++) {
+            for (int x = 0; x < w; x++) {
+                float dx = (x - cx) / rx, dy = (y - cy) / ry;
+                float d = (float) Math.sqrt(dx * dx + dy * dy);
+                float t = Math.max(0, Math.min(1, (d - d0) / (d1 - d0)));
+                int alpha = Math.round(Math.min(1, t * (maskOnly ? 1f : depth)) * 255);
+                px[y * w + x] = (alpha << 24);   // 黑
+            }
+        }
+        bm.setPixels(px, 0, w, 0, 0, w, h);
+        return bm;
+    }
+
+    /** 边缘模糊：当前墙画进复用快照 → RenderScript 模糊 → 径向蒙版 → 模糊层（零分配）。
+     *  翻转期间由 snapRun 以 160ms 连续调用（模糊内容跟上翻转，落定自然对齐）；
+     *  静止期只在零星换片/参数变化后调用一次。 */
+    private void takeSnapshot() {
+        if (blur <= 0 || getWidth() == 0 || rs == null || snapBmp == null) return;
+        Canvas c = new Canvas(snapBmp);
+        c.scale(480f / (float) getWidth(), 270f / (float) getHeight());
+        blurView.setVisibility(INVISIBLE);   // 模糊层自身不进快照
+        draw(c);
+        blurView.setVisibility(VISIBLE);
+        rsIn.copyFrom(snapBmp);
+        blurScript.forEach(rsOut);
+        rsOut.copyTo(blurBmp);
+        Canvas oc = new Canvas(outBmp);
+        oc.drawBitmap(blurBmp, 0, 0, null);
+        Paint pm = new Paint();
+        pm.setXfermode(new PorterDuffXfermode(PorterDuff.Mode.DST_IN));
+        oc.drawBitmap(maskBmp, 0, 0, pm);
+        pm.setXfermode(null);
+        blurView.invalidate();
+    }
+
+    /** 翻转期间 160ms 一帧的连续快照，让模糊内容跟上翻转；落定后由 settle 接管。 */
+    private final Runnable snapRun = new Runnable() {
+        @Override public void run() {
+            if (!running || paused) return;
+            if (!transActive) return;   // 墙静止：由零星换片/落定回调负责
+            takeSnapshot();
+            handler.postDelayed(this, 160);
+        }
+    };
+
+    /** 模糊层的径向蒙版（快照尺寸）：中心 alpha 0、边缘 1。 */
+    private Bitmap maskBitmap(int w, int h) {
+        if (maskBmp != null && maskBmp.getWidth() == w && maskRange == fxRange) {
+            return maskBmp;
+        }
+        Bitmap bm = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+        int[] px = new int[w * h];
+        float cx = w * 0.5f, cy = h * 0.46f, rx = w * 1.2f, ry = h * 0.9f;
+        float d0 = fxRange / 100f, d1 = fxRange / 100f + 0.16f;
+        for (int y = 0; y < h; y++) {
+            for (int x = 0; x < w; x++) {
+                float dx = (x - cx) / rx, dy = (y - cy) / ry;
+                float d = (float) Math.sqrt(dx * dx + dy * dy);
+                float t = Math.max(0, Math.min(1, (d - d0) / (d1 - d0)));
+                px[y * w + x] = Math.round(t * 255) << 24;
+            }
+        }
+        bm.setPixels(px, 0, w, 0, 0, w, h);
+        maskBmp = bm;
+        maskRange = fxRange;
+        return bm;
+    }
+
+    private ImageView face() {
+        ImageView iv = new ImageView(getContext());
+        iv.setScaleType(ImageView.ScaleType.CENTER_CROP);
+        return iv;
+    }
+
+    /* ---------------- images ---------------- */
+
+    private Bitmap bitmap(int idx) {
+        if (idx < 0 || idx >= posters.size()) return null;
+        Poster p = posters.get(idx);
+        String key = p.ph ? "ph:" + idx : p.file;
+        Bitmap hit = cache.get(key);
+        if (hit != null) return hit;
+        Bitmap bm = p.ph ? placeholder(idx) : decode(p);
+        if (bm != null) cache.put(key, bm);
+        return bm;
+    }
+
+    private Bitmap decode(Poster p) {
+        try {
+            File f = new File(dir, "posterwall" + File.separator + p.file);
+            BitmapFactory.Options o = new BitmapFactory.Options();
+            o.inJustDecodeBounds = true;
+            BitmapFactory.decodeFile(f.getAbsolutePath(), o);
+            int sample = 1;
+            while (o.outWidth / (sample * 2) >= cellW * 1.4f) sample *= 2;
+            o = new BitmapFactory.Options();
+            o.inSampleSize = sample;
+            o.inPreferredConfig = Bitmap.Config.RGB_565;
+            return BitmapFactory.decodeFile(f.getAbsolutePath(), o);
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    /** Colour-gradient tile with the movie title, for posters the pipeline could not fetch. */
+    private Bitmap placeholder(int idx) {
+        Poster p = posters.get(idx);
+        int w = Math.max(60, cellW), h = Math.max(90, cellH);
+        Bitmap bm = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+        Canvas cv = new Canvas(bm);
+        Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        paint.setShader(new LinearGradient(0, 0, w / 3f, h, p.dom, 0xFF0C0C10, Shader.TileMode.CLAMP));
+        cv.drawPaint(paint);
+        paint.setShader(null);
+        paint.setColor(0xF2FFFFFF);
+        paint.setTextSize(Math.max(11, w * 0.085f));
+        paint.setTextAlign(Paint.Align.CENTER);
+        String title = p.title == null ? "" : p.title;
+        int y = h / 2;
+        int line = (int) (paint.getTextSize() * 1.3f);
+        int per = Math.max(3, (int) (w / (paint.getTextSize() * 1.05f)));
+        int start = 0;
+        while (start < title.length() && y < h - 6) {
+            int end = Math.min(title.length(), start + per);
+            cv.drawText(title.substring(start, end), w / 2f, y, paint);
+            start = end;
+            y += line;
+        }
+        return bm;
+    }
+
+    private void preload() {
+        io.execute(() -> {
+            List<Integer> warm = new ArrayList<>();
+            for (List<Integer> pool : moods.values()) {
+                for (int i = 0; i < Math.min(pool.size(), 14); i++) warm.add(pool.get(i));
+            }
+            for (int idx : warm) {
+                if (!running) return;
+                bitmap(idx);
+            }
+        });
+    }
+
+    /* ---------------- mood pools and targets ---------------- */
+
+    private List<Integer> poolOf(String name) {
+        List<Integer> pool = moods.get(name);
+        if (pool != null && !pool.isEmpty()) return pool;
+        List<Integer> best = null;
+        for (List<Integer> p : moods.values()) {
+            if (best == null || p.size() > best.size()) best = p;
+        }
+        return best != null ? best : Collections.<Integer>emptyList();
+    }
+
+    private String biggestMood() {
+        String best = null;
+        for (Map.Entry<String, List<Integer>> e : moods.entrySet()) {
+            if (!e.getValue().isEmpty() && (best == null || e.getValue().size() > moods.get(best).size())) best = e.getKey();
+        }
+        return best;
+    }
+
+    private int[] assignTargets(String name) {
+        List<Integer> pool = poolOf(name);
+        List<Integer> bag = new ArrayList<>();
+        while (bag.size() < cells.size()) bag.addAll(shuffled(pool));
+        int off = bag.isEmpty() ? 0 : rnd.nextInt(pool.size());
+        int[] targets = new int[cells.size()];
+        for (int i = 0; i < cells.size(); i++) {
+            int t = bag.get((i + off) % bag.size());
+            if (t == cells.get(i).cur) t = bag.get((i + off + 1) % bag.size());
+            targets[i] = t;
+        }
+        return targets;
+    }
+
+    private List<Integer> shuffled(List<Integer> src) {
+        List<Integer> out = new ArrayList<>(src);
+        Collections.shuffle(out, rnd);
+        return out;
+    }
+
+    /* ---------------- flips ---------------- */
+
+    /** Two-stage card flip: to edge-on at 90°, swap the face, then finish — Android has no
+     *  backface-visibility, so both faces stay in the tree and hide at the midpoint. */
+    private void flip(Cell cell, int target, int flipDur) {
+        if (cell.busy || target < 0 || target == cell.cur) return;
+        cell.busy = true;
+        final Bitmap bmp = bitmap(target);
+        final boolean axisX = rnd.nextBoolean();
+        final float dir = rnd.nextBoolean() ? 1f : -1f;
+        final int half = Math.max(80, flipDur / 2);
+        DecelerateInterpolator ease = new DecelerateInterpolator(1.1f);
+        if (axisX) {
+            cell.card.animate().rotationX(90f * dir).rotationY(0f).setDuration(half).setInterpolator(ease)
+                    .withEndAction(() -> {
+                        cell.front.setVisibility(INVISIBLE);
+                        cell.back.setRotationX(180f);
+                        cell.back.setRotationY(0f);
+                        if (bmp != null) cell.back.setImageBitmap(bmp);
+                        cell.back.setVisibility(VISIBLE);
+                        cell.card.animate().rotationX(180f * dir).setDuration(half).setInterpolator(ease)
+                                .withEndAction(() -> settle(cell, target, bmp)).start();
+                    }).start();
+        } else {
+            cell.card.animate().rotationY(90f * dir).rotationX(0f).setDuration(half).setInterpolator(ease)
+                    .withEndAction(() -> {
+                        cell.front.setVisibility(INVISIBLE);
+                        cell.back.setRotationY(180f);
+                        cell.back.setRotationX(0f);
+                        if (bmp != null) cell.back.setImageBitmap(bmp);
+                        cell.back.setVisibility(VISIBLE);
+                        cell.card.animate().rotationY(180f * dir).setDuration(half).setInterpolator(ease)
+                                .withEndAction(() -> settle(cell, target, bmp)).start();
+                    }).start();
+        }
+    }
+
+    private void settle(Cell cell, int target, Bitmap bmp) {
+        cell.cur = target;
+        if (bmp != null) cell.front.setImageBitmap(bmp);
+        cell.front.setVisibility(VISIBLE);
+        cell.back.setVisibility(INVISIBLE);
+        cell.card.setRotationY(0f);
+        cell.card.setRotationX(0f);
+        cell.busy = false;
+    }
+
+    private void setFace(ImageView face, int idx) {
+        Bitmap bmp = bitmap(idx);
+        if (bmp != null) face.setImageBitmap(bmp);
+        else face.setImageDrawable(null);
+    }
+
+    private void fillInstant(String name) {
+        if (!dataReady || cells.isEmpty()) return;
+        int[] targets = assignTargets(name);
+        for (int i = 0; i < cells.size(); i++) {
+            cells.get(i).cur = targets[i];
+            setFace(cells.get(i).front, targets[i]);
+        }
+        mood = name;
+    }
+
+    /* ---------------- choreography (ported from poster-wall/index.html) ---------------- */
+
+    private List<FlipEntry> schedule(String m, int baseDur) {
+        int n = cells.size();
+        List<FlipEntry> out = new ArrayList<>();
+        if (n == 0) return out;
+        long itv = interval;
+        switch (m) {
+            case "random": {
+                List<Integer> order = new ArrayList<>();
+                for (int i = 0; i < n; i++) order.add(i);
+                Collections.shuffle(order, rnd);
+                for (int k = 0; k < n; k++)
+                    out.add(new FlipEntry(order.get(k), k * itv + jitter(itv * 0.3), baseDur));
+                break;
+            }
+            case "column":
+                for (int c = 0; c < cols; c++)
+                    for (int row = 0; row < rows; row++)
+                        out.add(new FlipEntry(row * cols + c,
+                                (long) (c * rows * itv * 0.55 + row * itv * 0.55) + jitter(itv * 0.4), baseDur));
+                break;
+            case "row":
+                for (int row = 0; row < rows; row++)
+                    for (int c = 0; c < cols; c++)
+                        out.add(new FlipEntry(row * cols + c,
+                                (long) (row * cols * itv * 0.55 + c * itv * 0.55) + jitter(itv * 0.4), baseDur));
+                break;
+            case "diagonal":
+                for (int i = 0; i < n; i++)
+                    out.add(new FlipEntry(i, (long) ((cells.get(i).c + cells.get(i).r) * itv * 1.15) + jitter(itv * 0.5), baseDur));
+                break;
+            case "checker": {
+                long spread = Math.max(900, (long) (n * itv * 0.32));
+                List<Integer> even = new ArrayList<>(), odd = new ArrayList<>();
+                for (int i = 0; i < n; i++) {
+                    if ((cells.get(i).c + cells.get(i).r) % 2 == 0) even.add(i);
+                    else odd.add(i);
+                }
+                Collections.shuffle(even, rnd);
+                Collections.shuffle(odd, rnd);
+                for (int i : even) out.add(new FlipEntry(i, (long) (rnd.nextFloat() * spread), baseDur));
+                for (int i : odd) out.add(new FlipEntry(i, spread + (long) (rnd.nextFloat() * spread), baseDur));
+                break;
+            }
+            case "spiral":
+            case "spiralIn": {
+                int[] order = spiralOrder(cols, rows);
+                Map<Integer, Integer> rank = new HashMap<>();
+                for (int k = 0; k < order.length; k++) rank.put(order[k], k);
+                for (int i = 0; i < n; i++) {
+                    int k = rank.containsKey(i) ? rank.get(i) : 0;
+                    double t = m.equals("spiral") ? k * itv * 0.6 : (order.length - 1 - k) * itv * 0.6;
+                    out.add(new FlipEntry(i, (long) t + jitter(itv * 0.3), baseDur));
+                }
+                break;
+            }
+            case "ripple": {
+                int seed = rnd.nextInt(n);
+                int seed2 = (seed + n / 2) % n;
+                Cell a = cells.get(seed), b = cells.get(seed2);
+                for (int i = 0; i < n; i++) {
+                    double d = Math.min(Math.hypot(cells.get(i).c - a.c, cells.get(i).r - a.r),
+                            Math.hypot(cells.get(i).c - b.c, cells.get(i).r - b.r));
+                    out.add(new FlipEntry(i, (long) (d * itv * 1.35) + jitter(itv * 0.6), baseDur));
+                }
+                break;
+            }
+            case "rippleRing": {
+                // 每次随机一个中心格，从它一圈圈向外递进
+                Cell seed = cells.get(rnd.nextInt(n));
+                long ringItv = Math.min(340, Math.max(100, (long) (itv * 1.8)));
+                for (int i = 0; i < n; i++) {
+                    int ring = Math.max(Math.abs(cells.get(i).c - seed.c), Math.abs(cells.get(i).r - seed.r));
+                    out.add(new FlipEntry(i, ring * ringItv + jitter(ringItv * 0.35), baseDur));
+                }
+                break;
+            }
+            case "converge": {
+                double cc = (cols - 1) / 2.0, rr = (rows - 1) / 2.0, maxD = 0;
+                double[] ds = new double[n];
+                for (int i = 0; i < n; i++) {
+                    ds[i] = Math.hypot(cells.get(i).c - cc, cells.get(i).r - rr);
+                    maxD = Math.max(maxD, ds[i]);
+                }
+                for (int i = 0; i < n; i++)
+                    out.add(new FlipEntry(i, (long) ((maxD - ds[i]) * itv * 1.35) + jitter(itv * 0.6), baseDur));
+                break;
+            }
+            case "stagger": {
+                long spread = Math.min(4200, Math.max(1100, (long) (n * itv * 0.28)));
+                for (int i = 0; i < n; i++)
+                    out.add(new FlipEntry(i, (long) (Math.pow(rnd.nextFloat(), 1.35) * spread), baseDur));
+                break;
+            }
+            case "splitflap": {
+                int d2 = Math.min(baseDur, 400);
+                for (int i = 0; i < n; i++) out.add(new FlipEntry(i, (long) (rnd.nextFloat() * 700), d2));
+                break;
+            }
+            default:
+                for (int i = 0; i < n; i++) out.add(new FlipEntry(i, i * itv, baseDur));
+        }
+        return out;
+    }
+
+    private long jitter(double amp) {
+        return (long) ((rnd.nextFloat() * 2 - 1) * amp);
+    }
+
+    private int[] spiralOrder(int cols, int rows) {
+        List<Integer> out = new ArrayList<>();
+        int x0 = 0, y0 = 0, x1 = cols - 1, y1 = rows - 1;
+        while (x0 <= x1 && y0 <= y1) {
+            for (int x = x0; x <= x1; x++) out.add(y0 * cols + x);
+            for (int y = y0 + 1; y <= y1; y++) out.add(y * cols + x1);
+            if (y1 > y0) for (int x = x1 - 1; x >= x0; x--) out.add(y1 * cols + x);
+            if (x1 > x0) for (int y = y1 - 1; y > y0; y--) out.add(y * cols + x0);
+            x0++;
+            y0++;
+            x1--;
+            y1--;
+        }
+        int[] arr = new int[out.size()];
+        for (int i = 0; i < arr.length; i++) arr[i] = out.get(i);
+        return arr;
+    }
+
+    private void transitionTo(String name) {
+        if (!dataReady) return;
+        cancelPending();
+        int[] targets = assignTargets(name);
+        List<FlipEntry> entries = schedule(mode, dur);
+        long total = 0;
+        for (FlipEntry e : entries) total = Math.max(total, e.t);
+        total += dur + 60;
+        transActive = true;
+        handler.removeCallbacks(snapRun);
+        handler.postDelayed(snapRun, 160);   // 翻转期间连续快照，模糊内容跟上翻转
+        for (FlipEntry e : entries) {
+            int idx = e.idx;
+            int target = targets[idx];
+            int d = e.dur;
+            if (idx >= cells.size()) continue;
+            Runnable run = () -> flip(cells.get(idx), target, d);
+            pending.add(run);
+            handler.postDelayed(() -> {
+                pending.remove(run);
+                if (running) run.run();
+            }, e.t);
+        }
+        mood = name;
+        // 最后一格落定的瞬间：模糊层同步到新排布（墙此刻静止，一次淡入）
+        final Runnable[] settleBox = new Runnable[1];
+        Runnable settle = () -> {
+            if (settleBox[0] != null) pending.remove(settleBox[0]);
+            if (!running) return;
+            transActive = false;
+            takeSnapshot();
+        };
+        settleBox[0] = settle;
+        pending.add(settle);
+        handler.postDelayed(settle, total + 60);
+        scheduleTour(total + hold * 1000L);
+    }
+
+    private void scheduleTour(long delay) {
+        if (tourRun != null) {
+            handler.removeCallbacks(tourRun);
+            pending.remove(tourRun);
+        }
+        tourRun = () -> {
+            tourRun = null;
+            if (running) tourNext();
+        };
+        pending.add(tourRun);
+        handler.postDelayed(tourRun, delay);
+    }
+
+    private Runnable tourRun;
+
+    private void tourNext() {
+        transActive = false;
+        List<String> names = new ArrayList<>(moods.keySet());
+        if (names.isEmpty()) return;
+        modeCursor = (modeCursor + 1) % modes.length;
+        List<String> others = new ArrayList<>();
+        for (String k : names) {
+            if (!k.equals(mood) && !moods.get(k).isEmpty()) others.add(k);
+        }
+        String next;
+        if (others.isEmpty()) {
+            next = names.get(rnd.nextInt(names.size()));
+        } else {
+            int total = 0;
+            for (String k : others) total += moods.get(k).size();
+            int x = rnd.nextInt(total);
+            next = others.get(others.size() - 1);
+            for (String k : others) {
+                x -= moods.get(k).size();
+                if (x <= 0) {
+                    next = k;
+                    break;
+                }
+            }
+        }
+        transitionTo(next);
+    }
+
+    private void cancelPending() {
+        for (Runnable r : new ArrayList<>(pending)) handler.removeCallbacks(r);
+        pending.clear();
+    }
+
+    /* ---------------- ambient single flips ---------------- */
+
+    private final Runnable ambientRun = new Runnable() {
+        @Override public void run() {
+            if (!running) return;
+            long now = System.currentTimeMillis();
+            if (!transActive && ambient && mood != null && now - ambientLast >= ambientEvery * 1000L) {
+                ambientLast = now;
+                List<Cell> free = new ArrayList<>();
+                for (Cell c : cells) if (!c.busy) free.add(c);
+                Collections.shuffle(free, rnd);
+                List<Integer> pool = poolOf(mood);
+                int k = Math.min(free.size(), 1 + rnd.nextInt(2));
+                boolean flipped = false;
+                for (int i = 0; i < k && !pool.isEmpty(); i++) {
+                    Cell cell = free.get(i);
+                    int t = pool.get(rnd.nextInt(pool.size()));
+                    if (t != cell.cur) {
+                        flip(cell, t, Math.max(420, (int) (dur * 0.8)));
+                        flipped = true;
+                    }
+                }
+                // 零星换片后同步模糊层（墙静止，一次淡入，不产生刷新感）
+                if (flipped) {
+                    lastSnap = now;
+                    handler.postDelayed(() -> {
+                        if (running && !transActive) takeSnapshot();
+                    }, Math.max(420, (int) (dur * 0.8)) + 60);
+                }
+            }
+            handler.postDelayed(this, 1000);
+        }
+    };
+
+    /* ---------------- lifecycle ---------------- */
+
+    @Override protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        if (isInEditMode()) return;
+        handler.removeCallbacks(ambientRun);
+        handler.post(ambientRun);
+    }
+
+    @Override protected void onDetachedFromWindow() {
+        super.onDetachedFromWindow();
+        handler.removeCallbacks(ambientRun);
+    }
+
+    @Override protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        super.onSizeChanged(w, h, oldw, oldh);
+        if (!dataReady || w == 0 || h == 0) return;
+        cancelPending();
+        buildGrid();
+        fillInstant(mood == null ? biggestMood() : mood);
+        scheduleTour(hold * 1000L);
+    }
+}
